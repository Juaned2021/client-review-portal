# Copy this file to .env and adjust the values. Never commit .env.

# --- Database -------------------------------------------------------------
# Local Docker Postgres (see docker-compose.yml). Use port 5433 if 5432 is busy.
POSTGRES_PORT=5432
DATABASE_URL="postgresql://portal:portal@localhost:5432/client_review_portal?schema=public"
# Optional: direct (non-pooled) connection for migrations, e.g. Supabase port 5432.
# DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# --- Auth.js --------------------------------------------------------------
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET="replace-me-with-a-long-random-string"
# Required behind proxies / on Vercel preview URLs.
AUTH_TRUST_HOST=true
